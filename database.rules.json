{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['t', 'p', 'l']) && $sid.length <= 40",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "l": {
          ".validate": "newData.isString() && newData.val().length <= 3"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "views": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
      },
      "visitors": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
      },
      "daily": {
        "$day": {
          "$k": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
          }
        }
      },
      "pages": {
        "$p": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      },
      "lang": {
        "$l": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      },
      "activity": {
        "$a": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('bans/' + auth.uid).exists()",
        "u": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "prof": {
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20 && (data.val() === newData.val() || ((!data.parent().child('nt').exists() || data.parent().child('nt').val() <= now - 604800000) && newData.parent().child('nt').val() === now))"
          },
          "nt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "pic": {
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 120000"
          },
          "av": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "signups": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['u', 't'])",
        "u": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && (!data.exists() || newData.val() === data.val())"
        },
        "t": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "a": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/) && newData.hasChildren(['uid'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "e": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 100)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('h').val() === auth.uid && !root.child('bans/' + auth.uid).exists()) || (data.exists() && data.child('h').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/) && newData.hasChildren(['h', 'st'])",
        "h": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "hn": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "m": {
          ".validate": "newData.val() === 'quiz' || newData.val() === 'puzzle' || newData.val() === 'bug' || newData.val() === 'vault' || newData.val() === 'race' || newData.val() === 'shoot'"
        },
        "d": {
          ".validate": "newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'medium' || newData.val() === 'hard'"
        },
        "p": {
          ".validate": "newData.val() === 'host' || newData.val() === 'self'"
        },
        "hp": {
          ".validate": "newData.isBoolean()"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
        },
        "sec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
        },
        "qs": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "st": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'reveal' || newData.val() === 'end'"
        },
        "qi": {
          ".validate": "newData.isNumber()"
        },
        "qt": {
          ".validate": "newData.isNumber()"
        },
        "c": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isNumber()"
        },
        "g": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "ho": {
          ".validate": "newData.isBoolean()"
        },
        "sk": {
          "$q": {
            ".validate": "newData.isBoolean() && $q.matches(/^[0-9]{1,2}$/)"
          }
        },
        "ban": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "res": {
          "$q": {
            "$uid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/h').exists() && !root.child('rooms/' + $code + '/ban/' + $uid).exists() && !root.child('bans/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['n'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "k": {
              ".validate": "newData.isNumber()"
            },
            "a": {
              ".validate": "newData.isNumber()"
            },
            "i": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "newData.isBoolean()"
            },
            "o": {
              ".validate": "newData.isBoolean()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ans": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/st').val() === 'play' && (root.child('rooms/' + $code + '/qi').val() + '') === $q && !root.child('rooms/' + $code + '/ban/' + $uid).exists()",
              ".validate": "newData.hasChildren(['c', 't'])",
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 30"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bank": {
      ".read": true,
      "$kind": {
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".validate": "$kind === 'quiz' || $kind === 'puzzle' || $kind === 'bug' || $kind === 'vault' || $kind === 'race' || $kind === 'shoot'"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "bans": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.hasChildren(['t', 'by'])",
        "r": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "u": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gifts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins/' + auth.uid).val() === true)",
        "$gid": {
          ".write": "auth != null && (((root.child('admins/' + auth.uid).val() === true) && !data.exists() && newData.exists()) || (auth.uid === $uid && data.exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['c', 't', 'by'])",
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "giftlog": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true && !data.exists()",
        ".validate": "newData.hasChildren(['u', 'c', 't', 'by'])",
        "u": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}