{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['t', 'p', 'l']) && $sid.length <= 40",
        "t": { ".validate": "newData.isNumber()" },
        "p": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "l": { ".validate": "newData.isString() && newData.val().length <= 3" },
        "$other": { ".validate": false }
      }
    },
    "stats": {
      ".read": true,
      "views": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" },
      "visitors": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" },
      "daily": { "$day": { "$k": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" } } },
      "pages": { "$p": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" } },
      "lang": { "$l": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" } },
      "activity": { "$a": { ".write": true, ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)" } }
    }
  }
}
