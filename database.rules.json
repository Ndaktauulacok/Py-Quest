{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['t', 'p', 'l']) && $sid.length <= 40",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "l": {
          ".validate": "newData.isString() && newData.val().length <= 3"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": true,
      "views": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
      },
      "visitors": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
      },
      "daily": {
        "$day": {
          "$k": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
          }
        }
      },
      "pages": {
        "$p": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      },
      "lang": {
        "$l": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      },
      "activity": {
        "$a": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "u": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        }
      }
    },
    "signups": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['u', 't'])",
        "u": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && (!data.exists() || newData.val() === data.val())"
        },
        "t": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "a": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/) && newData.hasChildren(['uid'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "e": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 100)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('h').val() === auth.uid) || (data.exists() && data.child('h').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/) && newData.hasChildren(['h', 'st'])",
        "h": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "hn": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "m": {
          ".validate": "newData.val() === 'quiz' || newData.val() === 'puzzle'"
        },
        "d": {
          ".validate": "newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'medium' || newData.val() === 'hard'"
        },
        "p": {
          ".validate": "newData.val() === 'host' || newData.val() === 'self'"
        },
        "hp": {
          ".validate": "newData.isBoolean()"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
        },
        "sec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
        },
        "qs": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "st": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'play' || newData.val() === 'reveal' || newData.val() === 'end'"
        },
        "qi": {
          ".validate": "newData.isNumber()"
        },
        "qt": {
          ".validate": "newData.isNumber()"
        },
        "c": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/h').exists()",
            ".validate": "newData.hasChildren(['n'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "k": {
              ".validate": "newData.isNumber()"
            },
            "a": {
              ".validate": "newData.isNumber()"
            },
            "i": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "newData.isBoolean()"
            },
            "o": {
              ".validate": "newData.isBoolean()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ans": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/st').val() === 'play' && (root.child('rooms/' + $code + '/qi').val() + '') === $q",
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 3"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}